<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="forest_arena">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <scene>
      <ambient>0.58 0.68 0.58 1.0</ambient>
      <background>0.80 0.92 0.82 1.0</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.95 0.95 0.90 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.15 -0.92</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.20 0.45 0.20 1.0</ambient>
            <diffuse>0.25 0.55 0.25 1.0</diffuse>
            <specular>0.02 0.02 0.02 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena walls (12 m square) -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="north_collision">
          <pose>0 6 0.35 0 0 0</pose>
          <geometry><box><size>12 0.2 0.7</size></box></geometry>
        </collision>
        <collision name="south_collision">
          <pose>0 -6 0.35 0 0 0</pose>
          <geometry><box><size>12 0.2 0.7</size></box></geometry>
        </collision>
        <collision name="east_collision">
          <pose>6 0 0.35 0 0 0</pose>
          <geometry><box><size>0.2 12 0.7</size></box></geometry>
        </collision>
        <collision name="west_collision">
          <pose>-6 0 0.35 0 0 0</pose>
          <geometry><box><size>0.2 12 0.7</size></box></geometry>
        </collision>

        <visual name="north_visual">
          <pose>0 6 0.35 0 0 0</pose>
          <geometry><box><size>12 0.2 0.7</size></box></geometry>
          <material><ambient>0.19 0.30 0.17 1</ambient><diffuse>0.22 0.36 0.20 1</diffuse></material>
        </visual>
        <visual name="south_visual">
          <pose>0 -6 0.35 0 0 0</pose>
          <geometry><box><size>12 0.2 0.7</size></box></geometry>
          <material><ambient>0.19 0.30 0.17 1</ambient><diffuse>0.22 0.36 0.20 1</diffuse></material>
        </visual>
        <visual name="east_visual">
          <pose>6 0 0.35 0 0 0</pose>
          <geometry><box><size>0.2 12 0.7</size></box></geometry>
          <material><ambient>0.19 0.30 0.17 1</ambient><diffuse>0.22 0.36 0.20 1</diffuse></material>
        </visual>
        <visual name="west_visual">
          <pose>-6 0 0.35 0 0 0</pose>
          <geometry><box><size>0.2 12 0.7</size></box></geometry>
          <material><ambient>0.19 0.30 0.17 1</ambient><diffuse>0.22 0.36 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Decorative tree macro instances (simple trunk + canopy) -->
    <model name="tree_01">
      <static>true</static>
      <pose>-4.5 4.0 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>1.2</length></cylinder></geometry><material><ambient>0.28 0.16 0.07 1</ambient><diffuse>0.35 0.20 0.10 1</diffuse></material></visual>
        <collision name="trunk_col"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="canopy"><pose>0 0 1.45 0 0 0</pose><geometry><sphere><radius>0.55</radius></sphere></geometry><material><ambient>0.08 0.35 0.12 1</ambient><diffuse>0.12 0.50 0.16 1</diffuse></material></visual>
      </link>
    </model>

    <model name="tree_02"><static>true</static><pose>-3.0 -4.0 0 0 0 0</pose><link name="link"><visual name="trunk"><pose>0 0 0.55 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>1.1</length></cylinder></geometry><material><ambient>0.30 0.18 0.08 1</ambient><diffuse>0.36 0.21 0.10 1</diffuse></material></visual><collision name="trunk_col"><pose>0 0 0.55 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>1.1</length></cylinder></geometry></collision><visual name="canopy"><pose>0 0 1.35 0 0 0</pose><geometry><sphere><radius>0.52</radius></sphere></geometry><material><ambient>0.09 0.34 0.11 1</ambient><diffuse>0.13 0.48 0.16 1</diffuse></material></visual></link></model>
    <model name="tree_03"><static>true</static><pose>4.2 3.6 0 0 0 0</pose><link name="link"><visual name="trunk"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry><material><ambient>0.28 0.16 0.07 1</ambient><diffuse>0.35 0.20 0.10 1</diffuse></material></visual><collision name="trunk_col"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry></collision><visual name="canopy"><pose>0 0 1.45 0 0 0</pose><geometry><sphere><radius>0.56</radius></sphere></geometry><material><ambient>0.08 0.35 0.12 1</ambient><diffuse>0.12 0.51 0.17 1</diffuse></material></visual></link></model>
    <model name="tree_04"><static>true</static><pose>3.5 -3.9 0 0 0 0</pose><link name="link"><visual name="trunk"><pose>0 0 0.58 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.16</length></cylinder></geometry><material><ambient>0.29 0.17 0.08 1</ambient><diffuse>0.35 0.20 0.10 1</diffuse></material></visual><collision name="trunk_col"><pose>0 0 0.58 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.16</length></cylinder></geometry></collision><visual name="canopy"><pose>0 0 1.4 0 0 0</pose><geometry><sphere><radius>0.54</radius></sphere></geometry><material><ambient>0.09 0.34 0.11 1</ambient><diffuse>0.13 0.49 0.16 1</diffuse></material></visual></link></model>
    <model name="tree_05"><static>true</static><pose>0.0 4.8 0 0 0 0</pose><link name="link"><visual name="trunk"><pose>0 0 0.62 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>1.24</length></cylinder></geometry><material><ambient>0.30 0.17 0.08 1</ambient><diffuse>0.36 0.21 0.10 1</diffuse></material></visual><collision name="trunk_col"><pose>0 0 0.62 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>1.24</length></cylinder></geometry></collision><visual name="canopy"><pose>0 0 1.50 0 0 0</pose><geometry><sphere><radius>0.58</radius></sphere></geometry><material><ambient>0.08 0.35 0.12 1</ambient><diffuse>0.12 0.51 0.17 1</diffuse></material></visual></link></model>
    <model name="tree_06"><static>true</static><pose>0.2 -4.7 0 0 0 0</pose><link name="link"><visual name="trunk"><pose>0 0 0.58 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.16</length></cylinder></geometry><material><ambient>0.29 0.17 0.08 1</ambient><diffuse>0.35 0.20 0.10 1</diffuse></material></visual><collision name="trunk_col"><pose>0 0 0.58 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>1.16</length></cylinder></geometry></collision><visual name="canopy"><pose>0 0 1.40 0 0 0</pose><geometry><sphere><radius>0.55</radius></sphere></geometry><material><ambient>0.09 0.34 0.11 1</ambient><diffuse>0.13 0.49 0.16 1</diffuse></material></visual></link></model>

    <!-- Fire marker locations (visual goal cues) -->
    <model name="fire_zone_alpha">
      <static>true</static>
      <pose>2.6 1.2 0.02 0 0 0</pose>
      <link name="link">
        <visual name="fire_marker">
          <geometry><cylinder><radius>0.22</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.85 0.20 0.05 1</ambient><diffuse>0.95 0.28 0.08 1</diffuse><emissive>0.25 0.05 0.00 1</emissive></material>
        </visual>
      </link>
    </model>

    <model name="fire_zone_bravo">
      <static>true</static>
      <pose>-2.4 -1.7 0.02 0 0 0</pose>
      <link name="link">
        <visual name="fire_marker">
          <geometry><cylinder><radius>0.22</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.85 0.20 0.05 1</ambient><diffuse>0.95 0.28 0.08 1</diffuse><emissive>0.25 0.05 0.00 1</emissive></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
