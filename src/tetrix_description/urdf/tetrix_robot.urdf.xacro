<?xml version="1.0"?>
<!--
  Tetrix Holonomic Drive Mobile Robot – URDF/xacro description.

  Drive layout: four omni wheels at the corners of a rectangular chassis.
  Omni wheels carry passive rollers perpendicular to the wheel axis, allowing
  free lateral sliding while still providing forward/reverse drive force.
  Holonomic motion is provided in simulation by the gazebo_ros_planar_move
  plugin, which accepts /cmd_vel geometry_msgs/Twist commands and produces
  full x/y/yaw velocity.

  Coordinate convention (REP-103):
    x → forward   y → left   z → up
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tetrix_robot">

  <!-- sim_backend: classic | gz | ign -->
  <xacro:arg name="sim_backend" default="classic"/>
  <xacro:property name="sim_backend" value="$(arg sim_backend)"/>

  <!-- =====================================================================
       Constants
  ====================================================================== -->
  <xacro:property name="PI" value="3.14159265358979"/>

  <!-- Chassis dimensions (metres): 250 x 250 x 100 mm -->
  <xacro:property name="chassis_length" value="0.25"/>
  <xacro:property name="chassis_width"  value="0.25"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass"   value="2.0"/>

  <!-- Wheel dimensions: radius 100 mm, width 25 mm -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.025"/>
  <xacro:property name="wheel_mass"   value="0.3"/>

  <!-- STL meshes are assumed to be authored in millimetres -->
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- Extra spacing to push wheels a little farther from the chassis center -->
  <xacro:property name="wheel_corner_margin" value="0.04"/>

  <!-- Wheel placement: distance from chassis centre (corner-mounted) -->
  <xacro:property name="wheel_x_offset" value="${chassis_length/2.0 - wheel_width/2.0 + wheel_corner_margin}"/>  <!-- front/rear -->
  <xacro:property name="wheel_y_offset" value="${chassis_width/2.0  - wheel_width/2.0 + wheel_corner_margin}"/>  <!-- left/right  -->
  <!-- Wheels are flush with the bottom of the chassis -->
  <xacro:property name="wheel_z_offset" value="${-chassis_height/2.0}"/>

  <!-- =====================================================================
       Materials (RViz)
  ====================================================================== -->
  <material name="tetrix_blue">
    <color rgba="0.05 0.30 0.70 1.0"/>
  </material>
  <material name="tetrix_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>
  <material name="tetrix_grey">
    <color rgba="0.50 0.50 0.50 1.0"/>
  </material>

  <!-- =====================================================================
       Inertia helper macros
  ====================================================================== -->
  <!-- Solid box inertia -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12.0)*(w*w + h*h)}" ixy="0" ixz="0"
        iyy="${(m/12.0)*(l*l + h*h)}" iyz="0"
        izz="${(m/12.0)*(l*l + w*w)}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder inertia (axis along y) -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12.0)*(3*r*r + h*h)}" ixy="0" ixz="0"
        iyy="${(m/2.0)*r*r}"             iyz="0"
        izz="${(m/12.0)*(3*r*r + h*h)}"/>
    </inertial>
  </xacro:macro>

  <!-- =====================================================================
       Wheel macro – creates link + joint + Gazebo material tag
       Omni-wheel friction model:
         mu1 (longitudinal – direction of travel) = 1.0   drive force
         mu2 (lateral      – roller free-spin axis) = 0.01 near-zero
  ====================================================================== -->
  <xacro:macro name="omni_wheel" params="name x_pos y_pos yaw">

    <link name="${name}_wheel_link">
      <visual>
        <!-- Rotate so cylinder axis aligns with Y (wheel spins around Y) -->
        <origin xyz="-0.062 -0.1 -0.072" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find tetrix_description)/meshes/Omni_Wheel.STL" scale="${mesh_scale}"/>
        </geometry>
        <material name="tetrix_black"/>
      </visual>
      <collision>
        <origin xyz="-0.062 -0.1 -0.072" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel_link"/>
      <origin xyz="${x_pos} ${y_pos} ${wheel_z_offset}" rpy="0 0 ${yaw}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
      <limit effort="10.0" velocity="5.0"/>
    </joint>

    <gazebo reference="${name}_wheel_link">
      <material>Gazebo/Black</material>
      <!-- Omni-wheel friction: high longitudinal grip, near-zero lateral
           (passive rollers allow free sliding perpendicular to wheel axis) -->
      <mu1>1.0</mu1>
      <mu2>0.01</mu2>
      <kp>1e6</kp>
      <kd>1.0</kd>
    </gazebo>

  </xacro:macro>

  <!-- =====================================================================
       Base footprint – virtual link at ground level
  ====================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- =====================================================================
       Chassis
  ====================================================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.1605 0.165 -0.08 " rpy="1.570796327 0 0"/>
      <geometry>
        <mesh filename="file://$(find tetrix_description)/meshes/Robot_base.STL" scale="${mesh_scale}"/>
      </geometry>
      <material name="tetrix_blue"/>
    </visual>
    <collision>
      <origin xyz="-0.1605 0.165 -0.08 " rpy="1.570796327 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
                       l="${chassis_length}"
                       w="${chassis_width}"
                       h="${chassis_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- =====================================================================
       Omni wheels (front-left, front-right, rear-left, rear-right)
       X-drive pattern: each wheel is mounted at +/-45 degrees
  ====================================================================== -->
  <xacro:omni_wheel name="front_left"
    x_pos=" ${wheel_x_offset}" y_pos=" ${wheel_y_offset}" yaw="${-PI/4.0}"/>
  <xacro:omni_wheel name="front_right"
    x_pos=" ${wheel_x_offset}" y_pos="${-wheel_y_offset}" yaw="${PI/4.0}"/>
  <xacro:omni_wheel name="rear_left"
    x_pos="${-wheel_x_offset}" y_pos=" ${wheel_y_offset}" yaw="${PI/4.0}"/>
  <xacro:omni_wheel name="rear_right"
    x_pos="${-wheel_x_offset}" y_pos="${-wheel_y_offset}" yaw="${-PI/4.0}"/>

  <!-- =====================================================================
       Optional sensors
  ====================================================================== -->

  <!-- LiDAR mount -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="tetrix_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.04" h="0.04"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0.12 0 ${chassis_height/2 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo LiDAR plugin (Classic only) -->
  <xacro:if value="${sim_backend == 'classic'}">
    <gazebo reference="lidar_link">
      <material>Gazebo/Grey</material>
      <sensor name="lidar" type="ray">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-${PI}</min_angle>
              <max_angle> ${PI}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- =====================================================================
       Gazebo – holonomic drive plugin (Classic only)
       Subscribes to /cmd_vel (geometry_msgs/Twist) and publishes /odom.
  ====================================================================== -->
  <xacro:if value="${sim_backend == 'classic'}">
    <gazebo>
      <plugin name="gazebo_ros_planar_move" filename="libgazebo_ros_planar_move.so">
        <ros>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>50</update_rate>
        <publish_rate>20</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Gazebo Harmonic / Ignition LiDAR sensor topic -->
  <xacro:unless value="${sim_backend == 'classic'}">
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="ray">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-${PI}</min_angle>
              <max_angle>${PI}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:unless>

  <!-- Gazebo Harmonic mecanum/omni drive system with odometry -->
  <xacro:if value="${sim_backend == 'gz'}">
    <gazebo>
      <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <wheel_separation>${2.0 * wheel_y_offset}</wheel_separation>
        <wheelbase>${2.0 * wheel_x_offset}</wheelbase>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Ignition Gazebo mecanum/omni drive system with odometry -->
  <xacro:if value="${sim_backend == 'ign'}">
    <gazebo>
      <plugin filename="ignition-gazebo-mecanum-drive-system" name="ignition::gazebo::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <wheel_separation>${2.0 * wheel_y_offset}</wheel_separation>
        <wheelbase>${2.0 * wheel_x_offset}</wheelbase>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
